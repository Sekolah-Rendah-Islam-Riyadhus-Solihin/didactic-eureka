---
import { languages, type SupportedLanguage } from "../../i18n/ui";
import { getLangFromUrl, getAlternateLanguageUrl } from "../../i18n/utils";

interface Props {
  className?: string;
  variant?: "header" | "topbar" | "mobile";
}

const { className = "", variant = "header" } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
---

{
  variant === "topbar" ? (
    <div class={`inline-flex items-center gap-1.5 text-xs ${className}`}>
      <span class="text-slate-400">🌐</span>
      {(Object.keys(languages) as SupportedLanguage[]).map((lang, index) => {
        const isCurrent = currentLang === lang;
        const targetUrl = getAlternateLanguageUrl(Astro.url, lang);
        return (
          <>
            {index > 0 && <span class="text-slate-600">|</span>}
            <a
              href={targetUrl}
              class={`px-1.5 py-0.5 rounded transition-colors text-[11px] font-semibold ${
                isCurrent
                  ? "text-amber-400 bg-slate-800"
                  : "text-slate-400 hover:text-white"
              }`}
              aria-current={isCurrent ? "page" : undefined}
              title={languages[lang].label}
            >
              {languages[lang].shortLabel}
            </a>
          </>
        );
      })}
    </div>
  ) : variant === "mobile" ? (
    <div
      class={`flex items-center justify-between p-2 rounded-xl bg-slate-100 ${className}`}
    >
      <span class="text-xs font-semibold text-slate-700 flex items-center gap-1.5">
        <span>🌐</span> Bahasa / Language
      </span>
      <div class="inline-flex rounded-lg bg-white p-0.5 shadow-sm border border-slate-200">
        {(Object.keys(languages) as SupportedLanguage[]).map((lang) => {
          const isCurrent = currentLang === lang;
          const targetUrl = getAlternateLanguageUrl(Astro.url, lang);
          return (
            <a
              href={targetUrl}
              class={`px-3 py-1 rounded-md text-xs font-bold transition-all ${
                isCurrent
                  ? "bg-school-primary text-white shadow-xs"
                  : "text-slate-600 hover:text-slate-900"
              }`}
              aria-current={isCurrent ? "page" : undefined}
            >
              {languages[lang].flag} {languages[lang].shortLabel}
            </a>
          );
        })}
      </div>
    </div>
  ) : (
    <div
      class={`inline-flex items-center rounded-lg bg-slate-100 p-0.5 border border-slate-200 shadow-xs ${className}`}
    >
      {(Object.keys(languages) as SupportedLanguage[]).map((lang) => {
        const isCurrent = currentLang === lang;
        const targetUrl = getAlternateLanguageUrl(Astro.url, lang);
        return (
          <a
            href={targetUrl}
            class={`flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold transition-all ${
              isCurrent
                ? "bg-white text-school-primary shadow-xs font-extrabold"
                : "text-slate-500 hover:text-slate-900"
            }`}
            aria-current={isCurrent ? "page" : undefined}
            title={languages[lang].label}
          >
            <span class="text-sm leading-none">{languages[lang].flag}</span>
            <span>{languages[lang].shortLabel}</span>
          </a>
        );
      })}
    </div>
  )
}
