---
import { schoolConfig } from '../../config/school.config';

const currentYear = new Date().getFullYear();
const isPrivate = schoolConfig.identity.schoolType === 'private';
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Column 1: School Identity & Motto -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-school-primary text-white flex items-center justify-center font-serif text-xl font-bold shadow">
            {schoolConfig.identity.shortName.charAt(0)}
          </div>
          <div>
            <h3 class="font-heading font-bold text-white text-base">
              {schoolConfig.identity.name}
            </h3>
            <p class="text-xs text-slate-400">
              {isPrivate ? 'Independent Primary Education' : 'Public Community Primary School'}
            </p>
          </div>
        </div>

        <p class="text-sm text-slate-400 italic">
          "{schoolConfig.identity.tagline}"
        </p>

        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <p><span class="text-slate-300 font-semibold">Affiliation:</span> {schoolConfig.identity.affiliation}</p>
          {schoolConfig.identity.registrationNumber && (
            <p><span class="text-slate-300 font-semibold">Reg No:</span> {schoolConfig.identity.registrationNumber}</p>
          )}
          <p><span class="text-slate-300 font-semibold">Established:</span> {schoolConfig.identity.establishedYear}</p>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-amber-400 mb-4">
          Explore Our School
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/about" class="hover:text-white transition-colors">About Our Ethos & Staff</a></li>
          <li><a href="/academics" class="hover:text-white transition-colors">Curriculum & Grade Stages</a></li>
          <li><a href="/admissions" class="hover:text-white transition-colors">{isPrivate ? 'Tuition & Enrollment' : 'Catchment & Registration'}</a></li>
          <li><a href="/news" class="hover:text-white transition-colors">School Notices & Term Dates</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Campus Map & Drop-off Gates</a></li>
        </ul>
      </div>

      <!-- Column 3: Parents & Policies -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-amber-400 mb-4">
          Parent Resources
        </h4>
        <ul class="space-y-2.5 text-sm">
          {schoolConfig.features.showCanteenMenu && (
            <li><a href="/academics#canteen" class="hover:text-white transition-colors">🥗 Canteen Healthy Meal Menu</a></li>
          )}
          {schoolConfig.features.showBusRoutes && (
            <li><a href="/contact#transport" class="hover:text-white transition-colors">🚌 School Bus & Walk-to-School Zones</a></li>
          )}
          <li><a href="/about#safeguarding" class="hover:text-white transition-colors">🛡️ Child Safeguarding & Safety Policy</a></li>
          <li><a href="/news" class="hover:text-white transition-colors">📅 Academic Calendar & Holidays</a></li>
          {schoolConfig.features.showParentPortalButton && (
            <li>
              <a href={schoolConfig.features.portalUrl} target="_blank" rel="noopener noreferrer" class="text-school-secondary hover:underline font-medium">
                🔐 Parent Portal Login →
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Column 4: Contact & Emergency -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-amber-400 mb-4">
          School Office
        </h4>
        <div class="text-sm text-slate-300 space-y-2">
          <p class="flex items-start gap-2">
            <span class="text-slate-400">📍</span>
            <span>
              {schoolConfig.contact.address.street}, {schoolConfig.contact.address.city}, {schoolConfig.contact.address.stateZip}
            </span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-slate-400">📞</span>
            <span>{schoolConfig.contact.phone}</span>
          </p>
          <p class="flex items-center gap-2 text-rose-400 font-semibold text-xs">
            <span>🚨</span>
            <span>Emergency: {schoolConfig.contact.emergencyPhone}</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-slate-400">✉️</span>
            <span>{schoolConfig.contact.email}</span>
          </p>
          <p class="flex items-center gap-2 text-xs text-slate-400 pt-1">
            <span>⏰</span>
            <span>{schoolConfig.contact.officeHours}</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom credits and white-label notice -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>
        © {currentYear} {schoolConfig.identity.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-[11px] text-slate-500">
        <span>Cloudflare Pages Ready ⚡</span>
        <span>•</span>
        <span>Expandable to Laravel Backend 🐘</span>
        <span>•</span>
        <span>WCAG 2.1 AA Accessible ♿</span>
      </div>
    </div>
  </div>
</footer>
