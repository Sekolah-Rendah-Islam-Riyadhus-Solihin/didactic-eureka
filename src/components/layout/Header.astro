---
import { schoolConfig } from "../../config/school.config";
import {
  useTranslations,
  getLangFromUrl,
  getLocalizedPath,
} from "../../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SchoolLogo from "./SchoolLogo.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { label: t("nav.home"), href: getLocalizedPath("/", lang) },
  { label: t("nav.about"), href: getLocalizedPath("/about", lang) },
  { label: t("nav.academics"), href: getLocalizedPath("/academics", lang) },
  { label: t("nav.admissions"), href: getLocalizedPath("/admissions", lang) },
  { label: t("nav.news"), href: getLocalizedPath("/news", lang) },
  { label: t("nav.contact"), href: getLocalizedPath("/contact", lang) },
];

const currentPath = Astro.url.pathname;
const isPrivate = schoolConfig.identity.schoolType === "private";
---

<!-- Top utility bar for quick contacts & term info -->
<div
  class="bg-slate-900 text-slate-300 text-xs py-2 px-3 sm:px-6 lg:px-8 border-b border-slate-800"
>
  <div
    class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-4"
  >
    <!-- Top Row on Mobile / Left Group on Desktop -->
    <div
      class="flex items-center justify-between sm:justify-start gap-3 w-full sm:w-auto"
    >
      <div class="flex items-center gap-3 sm:gap-4 text-[11px] sm:text-xs">
        <a
          href={`tel:${schoolConfig.contact.phone.replace(/[^0-9+]/g, "")}`}
          class="flex items-center gap-1.5 hover:text-amber-300 transition-colors"
          title="Hubungi Sekolah"
        >
          <svg
            class="w-3.5 h-3.5 text-school-secondary shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span class="font-medium tracking-tight"
            >{schoolConfig.contact.phone}</span
          >
        </a>

        <a
          href={`mailto:${schoolConfig.contact.email}`}
          class="hidden md:flex items-center gap-1.5 hover:text-amber-300 transition-colors"
        >
          <svg
            class="w-3.5 h-3.5 text-school-secondary shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span>{schoolConfig.contact.email}</span>
        </a>
      </div>

      <!-- Language switcher on mobile: pinned to top-right of Row 1 -->
      <div class="sm:hidden shrink-0">
        <LanguageSwitcher variant="topbar" />
      </div>
    </div>

    <!-- Bottom Row on Mobile / Right Group on Desktop: Academic Session Card & Portal -->
    <div
      class="flex items-center justify-between sm:justify-end gap-2.5 sm:gap-3 w-full sm:w-auto pt-1.5 sm:pt-0 border-t border-slate-800/80 sm:border-t-0"
    >
      <!-- Academic Session Card: Generous breathing space -->
      <div
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium bg-slate-800/90 border border-slate-700/60 text-slate-200 shadow-xs flex-1 sm:flex-initial justify-center sm:justify-start"
      >
        <span class="text-amber-400 shrink-0">📅</span>
        <span class="truncate">{schoolConfig.terms.currentTerm}</span>
      </div>

      {
        schoolConfig.features.showParentPortalButton && (
          <a
            href={schoolConfig.features.portalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-amber-400 hover:text-amber-300 transition-colors shrink-0 px-1 py-0.5"
            title={t("topbar.portalTitle")}
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              />
            </svg>
            <span>{t("nav.parentPortal")} →</span>
          </a>
        )
      }

      <!-- Desktop Language switcher -->
      <div
        class="hidden sm:flex items-center pl-1 border-l border-slate-700 shrink-0"
      >
        <LanguageSwitcher variant="topbar" />
      </div>
    </div>
  </div>
</div>

<!-- Main Navigation Bar -->
<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 sm:h-20">
      <!-- School Logo & Branding -->
      <a
        href={getLocalizedPath("/", lang)}
        class="flex items-center gap-2.5 sm:gap-3 group min-w-0 pr-2"
      >
        <div class="shrink-0">
          <SchoolLogo size="responsive" />
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="font-heading text-sm sm:text-lg lg:text-xl font-bold text-slate-900 leading-snug group-hover:text-school-primary transition-colors line-clamp-1 sm:line-clamp-none truncate sm:whitespace-normal"
          >
            {schoolConfig.identity.name}
          </span>
          <div
            class="flex items-center gap-1.5 sm:gap-2 text-[10px] sm:text-xs text-slate-500 font-medium"
          >
            <span
              class="uppercase tracking-wider text-[9px] sm:text-[10px] px-1.5 py-0.2 rounded font-bold {isPrivate ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'} shrink-0"
            >
              {isPrivate ? t("badge.private") : t("badge.government")}
            </span>
            <span class="hidden sm:inline">•</span>
            <span class="hidden sm:inline italic truncate"
              >{schoolConfig.identity.motto}</span
            >
          </div>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-1">
        {
          navItems.map((item) => {
            const isHome = item.href === "/" || item.href === "/en";
            const isActive = isHome
              ? currentPath === item.href
              : currentPath === item.href ||
                currentPath.startsWith(item.href + "/");
            return (
              <a
                href={item.href}
                class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-all ${
                  isActive
                    ? "text-school-primary bg-school-primary-light font-semibold"
                    : "text-slate-600 hover:text-school-primary hover:bg-slate-50"
                }`}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={getLocalizedPath("/admissions", lang)}
          class="px-4 py-2 rounded-lg text-sm font-semibold bg-school-primary text-white hover:bg-school-primary-hover shadow-sm transition-all hover:shadow"
        >
          {isPrivate ? t("nav.apply") : t("nav.enrollmentInfo")}
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="p-2 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
        >
          <svg
            id="hamburger-icon"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
          <svg
            id="close-icon"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 shadow-lg"
  >
    <div class="space-y-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block px-3 py-2.5 rounded-md text-base font-medium text-slate-700 hover:text-school-primary hover:bg-slate-50"
          >
            {item.label}
          </a>
        ))
      }
      <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
        <a
          href={getLocalizedPath("/admissions", lang)}
          class="w-full text-center px-4 py-2.5 rounded-lg text-sm font-semibold bg-school-primary text-white hover:bg-school-primary-hover shadow-sm"
        >
          {isPrivate ? t("nav.apply") : t("nav.enrollmentInfo")}
        </a>
        {
          schoolConfig.features.showParentPortalButton && (
            <a
              href={schoolConfig.features.portalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full text-center px-4 py-2 rounded-lg text-sm font-medium border border-slate-300 text-slate-700 hover:bg-slate-50"
            >
              {t("nav.parentPortal")} 🔐
            </a>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const hamburger = document.getElementById("hamburger-icon");
  const close = document.getElementById("close-icon");

  button?.addEventListener("click", () => {
    const isExpanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", (!isExpanded).toString());
    menu?.classList.toggle("hidden");
    hamburger?.classList.toggle("hidden");
    close?.classList.toggle("hidden");
  });
</script>
