---
import { schoolConfig } from '../../config/school.config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { SupportedLanguage } from '../../i18n/ui';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang: propLang } = Astro.props;
const lang: SupportedLanguage = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', lang) },
  { label: t('nav.about'), href: getLocalizedPath('/about', lang) },
  { label: t('nav.academics'), href: getLocalizedPath('/academics', lang) },
  { label: t('nav.admissions'), href: getLocalizedPath('/admissions', lang) },
  { label: t('nav.news'), href: getLocalizedPath('/news', lang) },
  { label: t('nav.contact'), href: getLocalizedPath('/contact', lang) },
];

const currentPath = Astro.url.pathname;
const isPrivate = schoolConfig.identity.schoolType === 'private';
const homeHref = getLocalizedPath('/', lang);
const admissionsHref = getLocalizedPath('/admissions', lang);
---

<!-- Top utility bar for quick contacts, term info & language switcher -->
<div class="bg-slate-900 text-slate-300 text-xs py-1.5 px-4 border-b border-slate-800">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1.5">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-school-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        {schoolConfig.contact.phone}
      </span>
      <span class="hidden md:flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-school-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        {schoolConfig.contact.email}
      </span>
    </div>

    <div class="flex items-center gap-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800 text-slate-200">
        📅 {schoolConfig.terms.currentTerm}
      </span>
      {schoolConfig.features.showParentPortalButton && (
        <a 
          href={schoolConfig.features.portalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-semibold text-amber-400 hover:text-amber-300 transition-colors"
          title="Access parent and teacher portal (Powered by Laravel)"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          {t('topbar.portal')}
        </a>
      )}
      <!-- Topbar Language Switcher -->
      <LanguageSwitcher variant="topbar" />
    </div>
  </div>
</div>

<!-- Main Navigation Bar -->
<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- School Logo & Branding -->
      <a href={homeHref} class="flex items-center gap-3 group">
        <div class="w-12 h-12 rounded-xl bg-school-primary text-white flex items-center justify-center shadow-md font-serif text-2xl font-bold transition-transform group-hover:scale-105">
          {schoolConfig.identity.shortName.charAt(0)}
        </div>
        <div class="flex flex-col">
          <span class="font-heading text-lg sm:text-xl font-bold text-slate-900 leading-tight group-hover:text-school-primary transition-colors">
            {schoolConfig.identity.name}
          </span>
          <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
            <span class="uppercase tracking-wider text-[10px] px-1.5 py-0.2 rounded font-bold {isPrivate ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}">
              {isPrivate ? (lang === 'en' ? 'Private Islamic School' : 'Sekolah Rendah Islam') : (lang === 'en' ? 'Government Primary' : 'Sekolah Kerajaan')}
            </span>
            <span>•</span>
            <span class="italic">{schoolConfig.identity.motto}</span>
          </div>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== homeHref && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-all ${
                isActive
                  ? 'text-school-primary bg-school-primary-light font-semibold'
                  : 'text-slate-600 hover:text-school-primary hover:bg-slate-50'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right CTAs & Language Switcher -->
      <div class="hidden sm:flex items-center gap-3">
        <LanguageSwitcher variant="header" />
        <a
          href={admissionsHref}
          class="px-4 py-2 rounded-lg text-sm font-semibold bg-school-primary text-white hover:bg-school-primary-hover shadow-sm transition-all hover:shadow"
        >
          {t('cta.apply')}
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <LanguageSwitcher variant="header" class="scale-90" />
        <button
          id="mobile-menu-button"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 shadow-lg">
    <div class="space-y-2">
      <!-- Mobile Language Switcher -->
      <div class="pb-2 mb-2 border-b border-slate-100">
        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Pilihan Bahasa / Language</p>
        <LanguageSwitcher variant="mobile" />
      </div>

      {navItems.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-school-primary hover:bg-slate-50"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
        <a
          href={admissionsHref}
          class="w-full text-center px-4 py-2.5 rounded-lg text-sm font-semibold bg-school-primary text-white hover:bg-school-primary-hover shadow-sm"
        >
          {t('cta.apply')}
        </a>
        {schoolConfig.features.showParentPortalButton && (
          <a
            href={schoolConfig.features.portalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full text-center px-4 py-2 rounded-lg text-sm font-medium border border-slate-300 text-slate-700 hover:bg-slate-50"
          >
            {t('topbar.portal')}
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  button?.addEventListener('click', () => {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', (!isExpanded).toString());
    menu?.classList.toggle('hidden');
    hamburger?.classList.toggle('hidden');
    close?.classList.toggle('hidden');
  });
</script>
