---
import { schoolConfig } from "../../config/school.config";
import type { SupportedLanguage } from "../../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "ms" } = Astro.props;

const phoneClean = schoolConfig.contact.phone.replace(/[^0-9+]/g, "");
// Format WhatsApp number (e.g., from +607-455 6000 or 074556000 to standard 60...)
const waNumber = phoneClean.startsWith("+")
  ? phoneClean.replace("+", "")
  : phoneClean.startsWith("0")
    ? "6" + phoneClean
    : phoneClean;

const waMessage = encodeURIComponent(
  lang === "ms"
    ? `Assalamualaikum / Salam Sejahtera Pentadbiran ${schoolConfig.identity.shortName}, saya ingin bertanya mengenai maklumat persekolahan.`
    : `Hello / Greetings Administration of ${schoolConfig.identity.shortName}, I would like to inquire about school information.`
);

const labels = {
  ms: {
    call: "Telefon",
    whatsapp: "WhatsApp",
    a11y: "Aksesibiliti",
    top: "Ke Atas",
  },
  en: {
    call: "Call",
    whatsapp: "WhatsApp",
    a11y: "A11y",
    top: "Top",
  },
}[lang] || {
  call: "Telefon",
  whatsapp: "WhatsApp",
  a11y: "Aksesibiliti",
  top: "Ke Atas",
};
---

<!-- Mobile Portrait Sticky Action Bar (Hidden on Tablets & Desktop) -->
<nav
  aria-label="Tindakan Pantas Mudah Alih"
  class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] px-2 py-1 flex items-center justify-around select-none"
>
  <!-- 1. Direct Dial Office -->
  <a
    href={`tel:${phoneClean}`}
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-700 hover:text-emerald-700 active:bg-slate-100 transition-colors p-1"
    title={labels.call}
  >
    <div class="w-7 h-7 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center mb-0.5">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.call}</span>
  </a>

  <!-- 2. Direct WhatsApp Chat (Crisp Official WhatsApp SVG) -->
  <a
    href={`https://wa.me/${waNumber}?text=${waMessage}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-700 hover:text-emerald-600 active:bg-slate-100 transition-colors p-1"
    title={labels.whatsapp}
  >
    <div class="w-7 h-7 rounded-full bg-[#25D366] text-white flex items-center justify-center mb-0.5 shadow-xs">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.04 7.58C8.84 7.58 8.65 7.65 8.5 7.84C8.25 8.09 7.5 8.84 7.5 10.36C7.5 11.88 8.61 13.34 8.77 13.54C8.93 13.74 10.96 16.88 14.07 18.22C14.81 18.54 15.39 18.73 15.84 18.87C16.58 19.11 17.26 19.07 17.8 18.99C18.4 18.9 19.64 18.24 19.9 17.5C20.16 16.76 20.16 16.13 20.08 16C20 15.87 19.86 15.8 19.6 15.67C19.34 15.54 18.06 14.91 17.82 14.82C17.58 14.73 17.41 14.69 17.24 14.94C17.07 15.19 16.59 15.75 16.44 15.93C16.29 16.11 16.14 16.13 15.88 16C15.62 15.87 14.78 15.6 13.79 14.71C13.02 14.02 12.5 13.17 12.35 12.92C12.2 12.67 12.33 12.53 12.46 12.4C12.58 12.29 12.72 12.11 12.86 11.95C13 11.79 13.05 11.67 13.14 11.49C13.23 11.31 13.18 11.16 13.12 11.03C13.06 10.9 12.58 9.72 12.38 9.24C12.19 8.77 11.99 8.83 11.83 8.83C11.68 8.83 11.51 8.83 11.34 8.83C11.17 8.83 10.9 8.89 10.67 9.14C10.44 9.39 9.8 10 9.8 11.23C9.8 12.46 10.7 13.65 10.83 13.82L9.04 7.58Z" />
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.whatsapp}</span>
  </a>

  <!-- 3. Accessibility Suite Modal Trigger -->
  <button
    type="button"
    id="mobile-a11y-trigger"
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-700 hover:text-amber-600 active:bg-slate-100 transition-colors p-1 cursor-pointer"
    title={labels.a11y}
  >
    <div class="w-7 h-7 rounded-full bg-amber-100 text-amber-900 flex items-center justify-center mb-0.5">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="4" r="2"/>
        <path d="M19 13v-2c-1.54.02-3.09-.75-4.07-1.83l-1.29-1.43c-.17-.19-.38-.34-.61-.45-.01 0-.01-.01-.02-.01H13c-.35-.2-.75-.3-1.19-.26-.64.07-1.21.46-1.5 1.04L8.7 11.3c-.31.62-.06 1.38.56 1.69.62.31 1.38.06 1.69-.56l1.05-2.1v4.67c-2.4.45-4.25 2.4-4.5 4.88-.3 2.92 1.83 5.48 4.75 5.78 2.92.3 5.48-1.83 5.78-4.75.14-1.35-.24-2.67-1.03-3.72V13h3zm-6.85 7c-1.65 0-3-1.35-3-3s1.35-3 3-3 3 1.35 3 3-1.35 3-3 3z"/>
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.a11y}</span>
  </button>

  <!-- 4. Smooth Back-to-Top Button -->
  <button
    type="button"
    id="mobile-back-to-top"
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-500 hover:text-slate-900 active:bg-slate-100 transition-colors p-1 cursor-pointer opacity-50 hover:opacity-100"
    title={labels.top}
  >
    <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center mb-0.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.top}</span>
  </button>
</nav>

<script>
  function setupMobileQuickBar() {
    const topBtn = document.getElementById("mobile-back-to-top");
    if (!topBtn) return;

    topBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const handleScroll = () => {
      if (window.scrollY > 250) {
        topBtn.classList.remove("opacity-50");
        topBtn.classList.add("opacity-100", "text-slate-900");
      } else {
        topBtn.classList.add("opacity-50");
        topBtn.classList.remove("opacity-100", "text-slate-900");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  setupMobileQuickBar();
  document.addEventListener("astro:after-swap", setupMobileQuickBar);
</script>
