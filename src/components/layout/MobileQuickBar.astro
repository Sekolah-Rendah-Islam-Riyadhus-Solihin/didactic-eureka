---
import { schoolConfig } from "../../config/school.config";
import type { SupportedLanguage } from "../../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "ms" } = Astro.props;

const phoneClean = schoolConfig.contact.phone.replace(/[^0-9+]/g, "");
// Format WhatsApp number (e.g., from +607-455 6000 or 074556000 to standard 60...)
const waNumber = phoneClean.startsWith("+")
  ? phoneClean.replace("+", "")
  : phoneClean.startsWith("0")
    ? "6" + phoneClean
    : phoneClean;

const waMessage = encodeURIComponent(
  lang === "ms"
    ? `Assalamualaikum / Salam Sejahtera Pentadbiran ${schoolConfig.identity.shortName}, saya ingin bertanya mengenai maklumat persekolahan.`
    : `Hello / Greetings Administration of ${schoolConfig.identity.shortName}, I would like to inquire about school information.`
);

const labels = {
  ms: {
    call: "Telefon",
    whatsapp: "WhatsApp",
    a11y: "Aksesibiliti",
    top: "Ke Atas",
  },
  en: {
    call: "Call",
    whatsapp: "WhatsApp",
    a11y: "A11y",
    top: "Top",
  },
}[lang] || {
  call: "Telefon",
  whatsapp: "WhatsApp",
  a11y: "Aksesibiliti",
  top: "Ke Atas",
};
---

<!-- Mobile Portrait Sticky Action Bar (Hidden on Tablets & Desktop) -->
<nav
  aria-label="Tindakan Pantas Mudah Alih"
  class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] px-2 py-1 flex items-center justify-around select-none"
>
  <!-- 1. Direct Dial Office (Font Awesome Phone SVG) -->
  <a
    href={`tel:${phoneClean}`}
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-700 hover:text-emerald-700 active:bg-slate-100 transition-colors p-1"
    title={labels.call}
  >
    <div class="w-7 h-7 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center mb-0.5">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 512 512" aria-hidden="true">
        <path d="M160.2 25C152.3 6.1 131.7-3.9 112.1 1.4l-5.5 1.5c-64.6 17.6-119.8 80.2-103.7 156.4 37.1 175 174.8 312.7 349.8 349.8 76.3 16.2 138.8-39.1 156.4-103.7l1.5-5.5c5.4-19.7-4.7-40.3-23.5-48.1l-97.3-40.5c-16.5-6.9-35.6-2.1-47 11.8l-38.6 47.2C233.9 335.4 177.3 277 144.8 205.3L189 169.3c13.9-11.3 18.6-30.4 11.8-47L160.2 25z"/>
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.call}</span>
  </a>

  <!-- 2. Direct WhatsApp Chat (Font Awesome WhatsApp SVG) -->
  <a
    href={`https://wa.me/${waNumber}?text=${waMessage}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-700 hover:text-emerald-600 active:bg-slate-100 transition-colors p-1"
    title={labels.whatsapp}
  >
    <div class="w-7 h-7 rounded-full bg-[#25D366] text-white flex items-center justify-center mb-0.5 shadow-xs">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 640 640" aria-hidden="true">
        <path d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1L319.9 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1zM319.9 502.7C286.7 502.7 254.2 493.8 225.9 477L219.2 473L149.4 491.3L168 423.2L163.6 416.2C145.1 386.8 135.4 352.9 135.4 318C135.4 216.3 218.2 133.5 320 133.5C369.3 133.5 415.6 152.7 450.4 187.6C485.2 222.5 506.6 268.8 506.5 318.1C506.5 419.9 421.6 502.7 319.9 502.7zM421.1 364.5C415.6 361.7 388.3 348.3 383.2 346.5C378.1 344.6 374.4 343.7 370.7 349.3C367 354.9 356.4 367.3 353.1 371.1C349.9 374.8 346.6 375.3 341.1 372.5C308.5 356.2 287.1 343.4 265.6 306.5C259.9 296.7 271.3 297.4 281.9 276.2C283.7 272.5 282.8 269.3 281.4 266.5C280 263.7 268.9 236.4 264.3 225.3C259.8 214.5 255.2 216 251.8 215.8C248.6 215.6 244.9 215.6 241.2 215.6C237.5 215.6 231.5 217 226.4 222.5C221.3 228.1 207 241.5 207 268.8C207 296.1 226.9 322.5 229.6 326.2C232.4 329.9 268.7 385.9 324.4 410C359.6 425.2 373.4 426.5 391 423.9C401.7 422.3 423.8 410.5 428.4 397.5C433 384.5 433 373.4 431.6 371.1C430.3 368.6 426.6 367.2 421.1 364.5z"/>
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.whatsapp}</span>
  </a>

  <!-- 3. Accessibility Suite Modal Trigger (Font Awesome Accessibility SVG) -->
  <button
    type="button"
    id="mobile-a11y-trigger"
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-700 hover:text-amber-600 active:bg-slate-100 transition-colors p-1 cursor-pointer"
    title={labels.a11y}
  >
    <div class="w-7 h-7 rounded-full bg-amber-100 text-amber-900 flex items-center justify-center mb-0.5">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 512 512" aria-hidden="true">
        <path d="M0 256a256 256 0 1 1 512 0 256 256 0 1 1 -512 0zm161.5-86.1c-12.2-5.2-26.3 .4-31.5 12.6s.4 26.3 12.6 31.5l11.9 5.1c17.3 7.4 35.2 12.9 53.6 16.3l0 50.1c0 4.3-.7 8.6-2.1 12.6l-28.7 86.1c-4.2 12.6 2.6 26.2 15.2 30.4s26.2-2.6 30.4-15.2l24.4-73.2c1.3-3.8 4.8-6.4 8.8-6.4s7.6 2.6 8.8 6.4l24.4 73.2c4.2 12.6 17.8 19.4 30.4 15.2S339 397 334.8 384.4l-28.7-86.1c-1.4-4.1-2.1-8.3-2.1-12.6l0-50.1c18.4-3.5 36.3-8.9 53.6-16.3l11.9-5.1c12.2-5.2 17.8-19.3 12.6-31.5s-19.3-17.8-31.5-12.6L338.7 175c-26.1 11.2-54.2 17-82.7 17s-56.5-5.8-82.7-17l-11.9-5.1zM256 160a40 40 0 1 0 0-80 40 40 0 1 0 0 80z"/>
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.a11y}</span>
  </button>

  <!-- 4. Smooth Back-to-Top Button -->
  <button
    type="button"
    id="mobile-back-to-top"
    class="flex flex-col items-center justify-center min-w-[58px] min-h-[44px] rounded-xl text-slate-500 hover:text-slate-900 active:bg-slate-100 transition-colors p-1 cursor-pointer opacity-50 hover:opacity-100"
    title={labels.top}
  >
    <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center mb-0.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
      </svg>
    </div>
    <span class="text-[10px] font-medium leading-none">{labels.top}</span>
  </button>
</nav>

<script>
  function setupMobileQuickBar() {
    const topBtn = document.getElementById("mobile-back-to-top");
    if (!topBtn) return;

    topBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const handleScroll = () => {
      if (window.scrollY > 250) {
        topBtn.classList.remove("opacity-50");
        topBtn.classList.add("opacity-100", "text-slate-900");
      } else {
        topBtn.classList.add("opacity-50");
        topBtn.classList.remove("opacity-100", "text-slate-900");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  setupMobileQuickBar();
  document.addEventListener("astro:after-swap", setupMobileQuickBar);
</script>
