---
import {
  getActiveSocialLinks,
  type ResolvedSocialLink,
} from "../../utils/socials";

interface Props {
  variant?: "icons" | "pills" | "cards" | "list";
  class?: string;
  iconSize?: "sm" | "md" | "lg";
  showLabel?: boolean;
}

const {
  variant = "icons",
  class: className = "",
  iconSize = "md",
  showLabel = false,
} = Astro.props;

const socialLinks: ResolvedSocialLink[] = getActiveSocialLinks();

const iconDimension =
  iconSize === "sm" ? "w-3.5 h-3.5" : iconSize === "lg" ? "w-5 h-5" : "w-4 h-4";
---

{
  socialLinks.length > 0 && (
    <>
      {variant === "icons" && (
        <div class={`flex flex-wrap items-center gap-2 ${className}`}>
          {socialLinks.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-8 h-8 rounded-full bg-slate-800/90 border border-slate-700/80 text-slate-300 ${s.hoverColorClass} hover:border-slate-600 flex items-center justify-center transition-all shadow-xs hover:scale-105`}
              title={`${s.name} (${s.handle})`}
              aria-label={`${s.name}: ${s.handle}`}
            >
              <svg
                class={iconDimension}
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d={s.svgPath} />
              </svg>
            </a>
          ))}
        </div>
      )}

      {variant === "pills" && (
        <div class={`flex flex-wrap items-center gap-2.5 ${className}`}>
          {socialLinks.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold ${s.bgClass} ${s.colorClass} border ${s.borderClass} transition-all shadow-xs hover:shadow-sm`}
            >
              <svg
                class="w-3.5 h-3.5 shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d={s.svgPath} />
              </svg>
              <span>{s.name}</span>
              <span class="opacity-70 font-normal">{s.handle}</span>
            </a>
          ))}
        </div>
      )}

      {variant === "cards" && (
        <div class={`grid grid-cols-1 sm:grid-cols-2 gap-3 ${className}`}>
          {socialLinks.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`p-3.5 rounded-2xl bg-slate-800/70 border border-slate-700/80 hover:border-slate-600 hover:bg-slate-800 transition-all flex items-center justify-between group`}
            >
              <div class="flex items-center gap-3">
                <div
                  class={`w-9 h-9 rounded-xl flex items-center justify-center ${s.bgClass} ${s.colorClass} border ${s.borderClass} shrink-0`}
                >
                  <svg
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d={s.svgPath} />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-white group-hover:text-amber-300 transition-colors">
                    {s.name}
                  </h4>
                  <p class="text-[11px] text-slate-400 font-mono">{s.handle}</p>
                </div>
              </div>
              <span class="text-xs text-slate-500 group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all">
                →
              </span>
            </a>
          ))}
        </div>
      )}

      {variant === "list" && (
        <div class={`flex flex-col gap-2 ${className}`}>
          {socialLinks.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`flex items-center gap-2 text-xs font-semibold ${s.colorClass} ${s.hoverColorClass} transition`}
            >
              <svg
                class="w-3.5 h-3.5 shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d={s.svgPath} />
              </svg>
              <span>
                {s.name} — {s.handle}
              </span>
            </a>
          ))}
        </div>
      )}
    </>
  )
}
