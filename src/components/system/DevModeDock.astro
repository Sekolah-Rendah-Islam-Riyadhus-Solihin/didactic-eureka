---
import { schoolConfig } from "../../config/school.config";
import type { SupportedLanguage } from "../../i18n/ui";
import { getAlternateLanguageUrl } from "../../i18n/utils";

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "ms" } = Astro.props;
const devConfig = schoolConfig.system?.devMode;
const developer = schoolConfig.developer;
if (!devConfig?.enabled) {
  // Do not render anything if devMode is disabled
}
---

{
  devConfig?.enabled && (
    <>
      <!-- Grid Overlay (toggled via DevModeDock) -->
      <div
        id="dev-grid-overlay"
        class="fixed inset-0 pointer-events-none z-50 hidden opacity-15"
      >
        <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 grid grid-cols-4 sm:grid-cols-6 lg:grid-cols-12 gap-4">
          {Array.from({ length: 12 }).map((_, i) => (
            <div class="h-full bg-rose-500 border-x border-rose-600/30 text-[9px] text-white p-1">
              {i + 1}
            </div>
          ))}
        </div>
      </div>

      <!-- Floating Dev Dock Pill (Higher bottom offset, drawer minimize style, transparent at rest) -->
      <div
        id="dev-mode-dock"
        class="fixed bottom-20 sm:bottom-24 right-3 sm:right-4 z-40 font-sans text-xs select-none transition-all duration-500 opacity-30 hover:opacity-100 group"
      >
        <!-- Collapsed Pill (Minimized to Dev Icon 🛠️, expands smoothly on hover) -->
        <div
          id="dev-dock-pill"
          class="flex items-center gap-1.5 p-1.5 sm:p-2 rounded-full bg-slate-900/90 text-slate-200 border border-slate-700/80 shadow-2xl backdrop-blur-md cursor-pointer hover:border-amber-400 hover:text-white transition-all group"
          title="Klik untuk buka Panel Pembangun / Dev Tools"
        >
          <!-- Suitable Dev Icon with Status Indicator -->
          <div class="w-8 h-8 rounded-full bg-slate-800 text-amber-400 flex items-center justify-center text-sm font-bold shadow-xs shrink-0 relative">
            <span>🛠️</span>
            <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-400 border border-slate-900 animate-pulse"></span>
          </div>

          <!-- Drawer contents: expands smoothly on hover -->
          <div class="flex items-center gap-1.5 max-w-0 overflow-hidden opacity-0 group-hover:max-w-[200px] group-hover:opacity-100 group-hover:pr-1.5 transition-all duration-300 whitespace-nowrap">
            <span class="font-mono font-bold text-[10px] tracking-wider text-amber-400 uppercase">
              DEV
            </span>

            <!-- Viewport Breakpoint Indicator -->
            {devConfig.showViewportBadge && (
              <div class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-slate-800 border border-slate-700 font-semibold text-slate-300">
                <span class="block sm:hidden">XS</span>
                <span class="hidden sm:block md:hidden">SM</span>
                <span class="hidden md:block lg:hidden">MD</span>
                <span class="hidden lg:block xl:hidden">LG</span>
                <span class="hidden xl:block 2xl:hidden">XL</span>
                <span class="hidden 2xl:block">2XL</span>
              </div>
            )}

            <!-- Current Locale -->
            <span class="text-[10px] font-mono uppercase text-slate-400">
              {lang}
            </span>
            <span class="text-slate-500 text-[10px]">⚙️</span>
          </div>
        </div>

        <!-- Expanded Dev Panel Popup -->
        <div
          id="dev-dock-panel"
          class="hidden absolute bottom-12 right-0 w-80 rounded-2xl bg-slate-900/95 border border-slate-700 p-4 text-slate-200 shadow-2xl backdrop-blur-lg space-y-3 mb-2"
        >
          <div class="flex items-center justify-between pb-2 border-b border-slate-800">
            <div class="flex items-center gap-1.5 font-bold text-xs text-white">
              <span>🛠️</span>
              <span>Alatan Pembangun (SRIRS)</span>
            </div>
            <button
              type="button"
              id="dev-dock-close"
              class="text-slate-400 hover:text-white text-xs cursor-pointer"
            >
              ✕
            </button>
          </div>

          <!-- Quick Info Details -->
          <div class="space-y-1.5 text-[11px] font-mono text-slate-400 bg-slate-950/70 p-2.5 rounded-xl border border-slate-800">
            <div class="flex justify-between items-center">
              <span class="text-slate-500">Viewport:</span>
              <span id="dev-res-w" class="text-amber-300 font-bold">
                1024px
              </span>
            </div>

            <!-- Live Language Selector -->
            <div class="flex justify-between items-center">
              <span class="text-slate-500">Bahasa:</span>
              <div class="flex items-center gap-1.5">
                <a
                  href={getAlternateLanguageUrl(Astro.url, "ms")}
                  class={`px-2 py-0.5 rounded text-[10px] font-bold font-mono transition-all ${
                    lang === "ms"
                      ? "bg-emerald-500 text-slate-950 shadow-xs font-black"
                      : "bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700"
                  }`}
                  title="Tukar ke Bahasa Melayu"
                >
                  🇲🇾 MS
                </a>
                <a
                  href={getAlternateLanguageUrl(Astro.url, "en")}
                  class={`px-2 py-0.5 rounded text-[10px] font-bold font-mono transition-all ${
                    lang === "en"
                      ? "bg-emerald-500 text-slate-950 shadow-xs font-black"
                      : "bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700"
                  }`}
                  title="Switch to English"
                >
                  🇬🇧 EN
                </a>
              </div>
            </div>

            <div class="flex justify-between truncate items-center">
              <span class="text-slate-500">Laluan:</span>
              <span class="text-slate-300 truncate max-w-[150px]" title={Astro.url.pathname}>
                {Astro.url.pathname}
              </span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="space-y-1.5 pt-0.5">
            <button
              type="button"
              id="toggle-grid-btn"
              class="w-full flex items-center justify-between px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-[11px] font-medium text-slate-200 transition cursor-pointer border border-slate-700/60"
            >
              <span>📐 Hamparan Grid Layout (12-Col)</span>
              <span id="grid-status-badge" class="text-[10px] text-slate-400">
                OFF
              </span>
            </button>

            <button
              type="button"
              id="log-config-btn"
              class="w-full flex items-center justify-between px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-[11px] font-medium text-slate-200 transition cursor-pointer border border-slate-700/60"
            >
              <span>📋 Cetak Config ke Konsol</span>
              <span class="text-[10px] text-amber-400">console.log</span>
            </button>
          </div>

          <!-- Developer Attribution Card -->
          {
            developer && (
              <div class="p-2.5 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] uppercase tracking-wider font-semibold text-slate-400 flex items-center gap-1">
                    <span>💡</span> Pembangun Sistem
                  </span>
                  <span class="text-[9px] font-mono text-amber-400/90 bg-amber-400/10 px-1.5 py-0.5 rounded border border-amber-400/20">
                    {developer.registrationNumber}
                  </span>
                </div>
                <div class="text-[11px] leading-tight">
                  <p class="font-bold text-white">{developer.author}</p>
                  <p class="text-slate-400 text-[10px]">{developer.company}</p>
                </div>
                <div class="flex items-center gap-1.5 pt-0.5">
                  <button
                    type="button"
                    id="dev-dock-open-attrib"
                    class="flex-1 py-1 px-2 rounded-lg bg-amber-400/15 hover:bg-amber-400/25 border border-amber-400/30 text-amber-300 text-[10px] font-semibold text-center transition cursor-pointer flex items-center justify-center gap-1"
                  >
                    <span>☕</span>
                    <span>Profil & Belanja Kopi</span>
                  </button>
                  {developer.github && (
                    <a
                      href={developer.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="py-1 px-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-[10px] font-medium transition flex items-center gap-1"
                      title="GitHub"
                    >
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                      </svg>
                      <span>GitHub</span>
                    </a>
                  )}
                </div>
              </div>
            )
          }

          <div class="pt-2 border-t border-slate-800 text-[10px] text-slate-500 flex justify-end items-center">
            <span class="text-[9px] font-mono bg-slate-800 px-1.5 py-0.5 rounded text-slate-400">
              devMode: true
            </span>
          </div>
        </div>
      </div>
    </>
  )
}

<script>
  function setupDevModeDock() {
    const pill = document.getElementById("dev-dock-pill");
    const panel = document.getElementById("dev-dock-panel");
    const closeBtn = document.getElementById("dev-dock-close");
    const gridBtn = document.getElementById("toggle-grid-btn");
    const gridOverlay = document.getElementById("dev-grid-overlay");
    const gridBadge = document.getElementById("grid-status-badge");
    const logBtn = document.getElementById("log-config-btn");
    const resText = document.getElementById("dev-res-w");
    const dockContainer = document.getElementById("dev-mode-dock");

    if (!pill || !panel) return;

    pill.addEventListener("click", () => {
      panel.classList.toggle("hidden");
    });

    closeBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      panel.classList.add("hidden");
    });

    const updateRes = () => {
      if (resText) {
        resText.textContent = `${window.innerWidth}px × ${window.innerHeight}px`;
      }
    };
    updateRes();
    window.addEventListener("resize", updateRes);

    gridBtn?.addEventListener("click", () => {
      if (!gridOverlay) return;
      const isHidden = gridOverlay.classList.contains("hidden");
      if (isHidden) {
        gridOverlay.classList.remove("hidden");
        if (gridBadge) {
          gridBadge.textContent = "ON";
          gridBadge.className = "text-[10px] text-emerald-400 font-bold";
        }
      } else {
        gridOverlay.classList.add("hidden");
        if (gridBadge) {
          gridBadge.textContent = "OFF";
          gridBadge.className = "text-[10px] text-slate-400";
        }
      }
    });

    logBtn?.addEventListener("click", () => {
      console.info(
        "%c[SRIRS Dev Mode] Diagnostic Snapshot:",
        "background: #047857; color: white; padding: 2px 6px; border-radius: 4px; font-weight: bold;",
        {
          timestamp: new Date().toISOString(),
          viewport: `${window.innerWidth}x${window.innerHeight}`,
          url: window.location.href,
          storage: {
            maintenanceBypass: sessionStorage.getItem("maintenance_bypass"),
          },
        }
      );
      alert("Diagnostic maklumat sistem telah dicetak ke Console (F12)!");
    });

    const openAttribBtn = document.getElementById("dev-dock-open-attrib");
    openAttribBtn?.addEventListener("click", () => {
      const devModal = document.getElementById("dev-modal");
      if (devModal) {
        devModal.classList.remove("hidden");
        devModal.classList.add("flex");
        panel.classList.add("hidden");
      }
    });

    // Scroll activity listener: 100% visible on scroll, transparent at rest
    let devScrollTimer: any;
    const handleDevScroll = () => {
      if (!dockContainer) return;
      dockContainer.classList.remove("opacity-30");
      dockContainer.classList.add("opacity-100");

      clearTimeout(devScrollTimer);
      devScrollTimer = setTimeout(() => {
        // Keep visible if panel is currently open
        const isPanelOpen = !panel?.classList.contains("hidden");
        if (!isPanelOpen) {
          dockContainer.classList.remove("opacity-100");
          dockContainer.classList.add("opacity-30");
        }
      }, 1800);
    };

    window.addEventListener("scroll", handleDevScroll, { passive: true });
  }

  setupDevModeDock();
  document.addEventListener("astro:after-swap", setupDevModeDock);
</script>
