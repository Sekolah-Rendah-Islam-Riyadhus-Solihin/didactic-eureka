---
import BaseLayout from "../layouts/BaseLayout.astro";
import { schoolConfig } from "../config/school.config";

const lang = "ms";

const notices = [
  {
    title: "Hari Sukan Tahunan & Hari Keluarga Sekolah",
    category: "Aktiviti",
    date: "28 April 2026",
    summary:
      "Acara sukaneka, larian berpagar, tarik tali dan jamuan santai sekeluarga di padang utama sekolah. Semua ibu bapa dan waris dijemput hadir memeriahkan program.",
    badgeColor: "bg-emerald-100 text-emerald-800",
  },
  {
    title: "Karnival Al-Quran & Kesenian Islam 2026",
    category: "Akademik",
    date: "12 Mei 2026",
    summary:
      "Pertandingan hafazan cilik, seni khat, tilawah dan syarahan agama. Pameran modul hafazan murid turut dibuka kepada umum.",
    badgeColor: "bg-sky-100 text-sky-800",
  },
  {
    title: "Hari Bicara Prestasi Murid Bersama Guru Kelas",
    category: "Pemberitahuan",
    date: "22 – 24 April 2026",
    summary:
      "Sesi perbincangan empat mata bersama guru kelas dan guru tasmik bagi menyemak perkembangan akademik serta pencapaian hafazan Al-Quran anak-anak.",
    badgeColor: "bg-amber-100 text-amber-800",
  },
  {
    title: "Peringatan Etika Pemakaian Pakaian Seragam Sekolah",
    category: "Disiplin",
    date: "15 April 2026",
    summary:
      "Semua murid lelaki diwajibkan memakai Baju Melayu lengkap bersongkok hitam pada hari Jumaat. Murid perempuan berbaju kurung putih lengkap berlencana sekolah.",
    badgeColor: "bg-purple-100 text-purple-800",
  },
];
---

<BaseLayout lang={lang} title="Berita, Hebahan & Takwim Persekolahan">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400"
        >Hebahan Warga Sekolah</span
      >
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">
        Berita & Takwim Akademik
      </h1>
      <p
        class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light"
      >
        Ikuti perkembangan aktiviti, takwim cuti dan makluman pekeliling penting
        daripada pihak pentadbiran {schoolConfig.identity.shortName}.
      </p>
    </div>
  </section>

  <!-- Term Dates Overview -->
  <section class="py-12 bg-school-primary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span
            class="text-xs font-bold uppercase tracking-widest text-amber-300"
            >Sesi Akademik 2026</span
          >
          <h2 class="text-2xl font-heading font-bold">
            {schoolConfig.terms.currentTerm}
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full md:w-auto">
          {
            schoolConfig.terms.termDates.map((t) => (
              <div class="bg-black/20 p-3.5 rounded-xl border border-white/10 text-center">
                <div class="text-xs text-amber-200 font-bold">{t.term}</div>
                <div class="text-xs text-white font-medium">{t.dates}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Notices List -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-heading font-bold text-slate-900">
          Pekeliling & Hebahan Terkini
        </h2>
        <span class="text-xs text-slate-500 font-medium"
          >Dikemaskini Setiap Minggu</span
        >
      </div>

      <div class="space-y-4">
        {
          notices.map((n) => (
            <article class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-school-primary/40 transition space-y-2">
              <div class="flex items-center gap-3">
                <span
                  class={`text-[11px] font-bold px-2 py-0.5 rounded ${n.badgeColor}`}
                >
                  {n.category}
                </span>
                <span class="text-xs text-slate-400 font-medium">{n.date}</span>
              </div>
              <h3 class="font-heading font-bold text-lg text-slate-900 hover:text-school-primary transition-colors">
                {n.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {n.summary}
              </p>
            </article>
          ))
        }
      </div>

      <!-- School Holidays Note -->
      <div
        class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 space-y-3"
      >
        <h3
          class="font-heading font-bold text-base text-emerald-900 flex items-center gap-2"
        >
          📅 Hari Kelepasan Am & Cuti Persekolahan KPM
        </h3>
        <p class="text-xs text-emerald-800 leading-relaxed">
          {schoolConfig.identity.shortName} mematuhi takwim rasmi cuti persekolahan
          Kementerian Pendidikan Malaysia (KPM) Kumpulan B serta cuti peristiwa /
          am Negeri Johor. Cuti khas turut diperuntukkan bagi sambutan perayaan Islam
          seperti Hari Raya Aidilfitri, Hari Raya Aidiladha dan Maulidur Rasul.
        </p>
        <p class="text-xs text-emerald-700 font-semibold">
          Sila rujuk pekeliling takwim rasmi tahunan yang diedarkan oleh pejabat
          sekolah atau muat turun di portal waris.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
