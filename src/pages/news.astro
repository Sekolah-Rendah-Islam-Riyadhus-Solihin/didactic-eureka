---
import BaseLayout from '../layouts/BaseLayout.astro';
import { schoolConfig } from '../config/school.config';

const notices = [
  {
    title: "Annual Sports Day & Family Picnic Scheduled",
    category: "Events",
    date: "April 28, 2026",
    summary: "Join us for track races, obstacle courses, sack racing, and a shared community picnic on our main school oval.",
    badgeColor: "bg-emerald-100 text-emerald-800",
  },
  {
    title: "Book Week 2026: 'Read, Grow, Inspire'",
    category: "Academic",
    date: "May 12, 2026",
    summary: "Students are invited to dress up as their favorite storybook character! Author visits and book fair purchases all week.",
    badgeColor: "bg-sky-100 text-sky-800",
  },
  {
    title: "Term 3 Parent-Teacher Consultation Evenings",
    category: "Notices",
    date: "April 22 – 24, 2026",
    summary: "Class teachers will discuss mid-year progress, reading milestones, and individualized growth goals.",
    badgeColor: "bg-amber-100 text-amber-800",
  },
  {
    title: "Spring Term Uniform Guidelines & Sun Protection",
    category: "Policy",
    date: "April 15, 2026",
    summary: "Reminder that all pupils must wear wide-brim school sun hats during outdoor play periods throughout the warmer months.",
    badgeColor: "bg-purple-100 text-purple-800",
  },
];
---

<BaseLayout title="News, Events & Term Dates">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">School Bulletins</span>
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">News & Academic Calendar</h1>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light">
        Stay up to date with school activities, holiday schedules, and important community notices.
      </p>
    </div>
  </section>

  <!-- Term Dates Overview -->
  <section class="py-12 bg-school-primary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-300">2026 Academic Year</span>
          <h2 class="text-2xl font-heading font-bold">{schoolConfig.terms.currentTerm}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full md:w-auto">
          {schoolConfig.terms.termDates.map((t) => (
            <div class="bg-black/20 p-3.5 rounded-xl border border-white/10 text-center">
              <div class="text-xs text-amber-200 font-bold">{t.term}</div>
              <div class="text-xs text-white font-medium">{t.dates}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Notices List -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-heading font-bold text-slate-900">Latest Circulars & Announcements</h2>
        <span class="text-xs text-slate-500 font-medium">Updated Weekly</span>
      </div>

      <div class="space-y-4">
        {notices.map((n) => (
          <article class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-school-primary/40 transition space-y-2">
            <div class="flex items-center gap-3">
              <span class={`text-[11px] font-bold px-2 py-0.5 rounded ${n.badgeColor}`}>
                {n.category}
              </span>
              <span class="text-xs text-slate-400 font-medium">{n.date}</span>
            </div>
            <h3 class="font-heading font-bold text-lg text-slate-900 hover:text-school-primary transition-colors">
              {n.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {n.summary}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
