---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { schoolConfig } from '../../config/school.config';
import { getLocalizedPath } from '../../i18n/utils';

const lang = 'en';

const values = [
  { icon: "🕌", title: "Faith & Taqwa", desc: "Every child nurtures strong iman, righteous character, and a deep love for Allah and His Messenger ﷺ." },
  { icon: "🔍", title: "Curiosity & Knowledge", desc: "We celebrate questions, critical thinking, and the Islamic tradition of seeking knowledge throughout life." },
  { icon: "🌱", title: "Resilience & Sabr", desc: "Challenges are embraced with patience and perseverance — qualities rooted in Islamic teachings." },
  { icon: "⭐", title: "Integrity & Akhlak", desc: "Honoring our teachers, classmates, families, and the broader Muslim community we are part of." },
];

const staffMembers = [
  { name: schoolConfig.identity.headteacher.name, role: schoolConfig.identity.headteacher.title, exp: "20+ Years in Islamic Primary Education" },
  { name: "Ustaz Ahmad bin Zainudin", role: "Deputy Head & Tahfiz Programme Lead", exp: "15 Years in Quranic Education" },
  { name: "Puan Siti Rahimah binti Ismail", role: "Early Years & Kindergarten Coordinator", exp: "12 Years in Early Childhood" },
  { name: "Cikgu Faridah binti Hassan", role: "Special Education & Inclusion (Pendidikan Khas)", exp: "10 Years in Child Development" },
];

const facilities = [
  { name: "Islamic Library & Reading Corner", desc: "Over 4,000 age-appropriate Islamic storybooks, Quranic references, and Arabic learning resources." },
  { name: "Tahfiz Hall & Prayer Musolla", desc: "Purpose-built Quran memorisation hall with individual recitation pods and a dedicated musolla for all prayers." },
  { name: "STEM & Discovery Lab", desc: "Hands-on science kits, tablets, robotics kits, and interactive learning tools aligned with the national curriculum." },
  { name: "Sports Court & School Garden", desc: "Multi-purpose covered court for badminton and futsal, plus an organic school garden for environmental education." },
];
---

<BaseLayout lang={lang} title="About Our School">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Our Ethos & Community</span>
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">About {schoolConfig.identity.name}</h1>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light">
        An integrated Islamic primary school committed to building faith, character, and academic excellence since {schoolConfig.identity.establishedYear}.
      </p>

      <!-- Sub Navigation Tabs between About & Stakeholders -->
      <div class="pt-4 flex justify-center">
        <div
          class="inline-flex p-1 rounded-xl bg-slate-800/90 border border-slate-700/80 max-w-full overflow-x-auto"
        >
          <a
            href={getLocalizedPath("/about", lang)}
            class="px-4 py-2 rounded-lg text-xs font-bold bg-amber-400 text-slate-950 shadow-xs transition-all whitespace-nowrap"
          >
            🏛️ School Overview
          </a>
          <a
            href={getLocalizedPath("/about/stakeholders", lang)}
            class="px-4 py-2 rounded-lg text-xs font-medium text-slate-300 hover:text-white transition-all whitespace-nowrap"
          >
            🤝 Stakeholder Information
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Headteacher Message -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-school-primary">Headteacher's Welcome</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900">
            "Nurturing the hearts and minds of our children — for this world and the hereafter."
          </h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Welcome to {schoolConfig.identity.name}. In our classrooms, you will see children memorising the Quran with joy, engaging in vibrant learning discussions, conducting science experiments, and building friendships grounded in Islamic values.
          </p>
          <p class="text-slate-600 text-sm leading-relaxed">
            Whether your child is beginning their kindergarten journey or approaching their UPSR preparation year, our dedicated teaching faculty ensures they feel seen, nurtured, and academically challenged.
          </p>
          <div class="pt-2 border-l-2 border-school-primary pl-4">
            <p class="font-heading font-bold text-slate-900">{schoolConfig.identity.headteacher.name}</p>
            <p class="text-xs text-slate-500">{schoolConfig.identity.headteacher.title}</p>
          </div>
        </div>

        <div class="bg-slate-100 rounded-3xl p-8 border border-slate-200 space-y-6">
          <h3 class="font-heading font-bold text-xl text-slate-900">Our School Mission</h3>
          <p class="text-sm text-slate-700 leading-relaxed italic">
            "{schoolConfig.identity.tagline}"
          </p>
          <div class="space-y-3 pt-2 text-xs text-slate-600">
            <p><strong>Affiliation:</strong> {schoolConfig.identity.affiliation}</p>
            <p><strong>Curriculum:</strong> Integrated KSSR & Tahfiz (Quran Memorisation) Programme</p>
            <p><strong>Community:</strong> Over 520 students, active PIBG, and a dedicated team of Islamic educators.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-school-primary">Foundational Pillars</span>
        <h2 class="text-3xl font-heading font-bold text-slate-900">The Values We Live By Every Day</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((v) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
            <div class="text-3xl">{v.icon}</div>
            <h3 class="font-heading font-bold text-base text-slate-900">{v.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Facilities Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-school-primary">Campus Environment</span>
        <h2 class="text-3xl font-heading font-bold text-slate-900">Facilities Designed For Young Learners</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {facilities.map((fac) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-school-primary/40 transition space-y-2">
            <h3 class="font-heading font-bold text-base text-slate-900 flex items-center gap-2">
              <span class="text-school-primary">🏫</span> {fac.name}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">{fac.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Teaching Staff -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-school-primary">Our Dedicated Educators</span>
        <h2 class="text-3xl font-heading font-bold text-slate-900">Leadership & Key Staff</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {staffMembers.map((s) => (
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2 text-center">
            <div class="w-14 h-14 mx-auto rounded-full bg-gradient-to-tr from-school-primary to-emerald-500 flex items-center justify-center text-white text-2xl shadow">
              👨‍🏫
            </div>
            <h3 class="font-heading font-bold text-sm text-slate-900">{s.name}</h3>
            <p class="text-xs text-school-primary font-semibold">{s.role}</p>
            <p class="text-[11px] text-slate-500">{s.exp}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stakeholders Quick Link Banner -->
  <section class="py-12 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-800 to-emerald-950 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-md border border-slate-800"
      >
        <div class="space-y-2 text-center md:text-left">
          <div
            class="inline-flex items-center gap-2 text-xs font-bold text-amber-400 uppercase tracking-widest"
          >
            <span>🏛️</span> Governance & Leadership
          </div>
          <h3 class="text-xl sm:text-2xl font-heading font-bold text-white">
            Stakeholder Information (Board of Governors, PTA & Leadership)
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
            Explore the governance structure of our Board of Governors (LPS),
            Parents & Teachers Association (PTA), school executive leadership,
            and regulatory affiliations.
          </p>
        </div>
        <a
          href={getLocalizedPath("/about/stakeholders", lang)}
          class="whitespace-nowrap px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-bold transition shadow-md"
        >
          View Stakeholder Information →
        </a>
      </div>
    </div>
  </section>

  <!-- Safeguarding & Safety Commitment -->
  <section id="safeguarding" class="py-12 bg-emerald-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-emerald-400 uppercase tracking-widest">
            <span>🛡️</span> Child Safeguarding & Wellbeing Policy
          </div>
          <h3 class="text-xl sm:text-2xl font-heading font-bold">
            Our highest commitment is the safety and happiness of every child.
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl">
            All teaching and auxiliary staff undergo rigorous background verification, criminal record checks, and annual first-aid certification. Child safeguarding protocols are reviewed every academic year.
          </p>
        </div>
        <a
          href={getLocalizedPath('/contact', lang)}
          class="whitespace-nowrap px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition shadow"
        >
          Contact Safeguarding Team →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
