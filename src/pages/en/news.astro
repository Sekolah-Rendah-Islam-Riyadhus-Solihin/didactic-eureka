---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { schoolConfig } from '../../config/school.config';

const lang = 'en';

const notices = [
  {
    title: "Annual Sports Day & Family Gathering",
    category: "Events",
    date: "28 April 2026",
    summary: "Join us for a day of friendly track events, obstacle races, tug-of-war, and a shared community gathering on our school field. All families welcome!",
    badgeColor: "bg-emerald-100 text-emerald-800",
  },
  {
    title: "Quran & Islamic Arts Showcase 2026",
    category: "Academic",
    date: "12 May 2026",
    summary: "Students from all years will present their Quran recitation, calligraphy, and Islamic art projects. Parents and guardians are warmly invited.",
    badgeColor: "bg-sky-100 text-sky-800",
  },
  {
    title: "Term 2 Parent-Teacher Consultation Sessions",
    category: "Notices",
    date: "22 – 24 April 2026",
    summary: "Class teachers will discuss mid-year academic progress, Tahfiz achievements, and individual development goals with parents.",
    badgeColor: "bg-amber-100 text-amber-800",
  },
  {
    title: "School Uniform & Dress Code Reminder",
    category: "Policy",
    date: "15 April 2026",
    summary: "A reminder to all parents: boys are required to wear the school's light blue baju Melayu on Fridays. Girls must wear the white baju kurung with the school badge at all times.",
    badgeColor: "bg-purple-100 text-purple-800",
  },
];
---

<BaseLayout lang={lang} title="News, Events & Academic Calendar">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">School Bulletins & Notices</span>
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">News & Academic Calendar</h1>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light">
        Stay up to date with school events, holiday schedules, and important community notices from {schoolConfig.identity.shortName}.
      </p>
    </div>
  </section>

  <!-- Term Dates Overview -->
  <section class="py-12 bg-school-primary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-300">2026 Academic Year</span>
          <h2 class="text-2xl font-heading font-bold">{schoolConfig.terms.currentTerm}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full md:w-auto">
          {schoolConfig.terms.termDates.map((t) => (
            <div class="bg-black/20 p-3.5 rounded-xl border border-white/10 text-center">
              <div class="text-xs text-amber-200 font-bold">{t.term}</div>
              <div class="text-xs text-white font-medium">{t.dates}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Notices List -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-heading font-bold text-slate-900">Latest Circulars & Announcements</h2>
        <span class="text-xs text-slate-500 font-medium">Updated Weekly</span>
      </div>

      <div class="space-y-4">
        {notices.map((n) => (
          <article class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-school-primary/40 transition space-y-2">
            <div class="flex items-center gap-3">
              <span class={`text-[11px] font-bold px-2 py-0.5 rounded ${n.badgeColor}`}>
                {n.category}
              </span>
              <span class="text-xs text-slate-400 font-medium">{n.date}</span>
            </div>
            <h3 class="font-heading font-bold text-lg text-slate-900 hover:text-school-primary transition-colors">
              {n.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {n.summary}
            </p>
          </article>
        ))}
      </div>

      <!-- School Holidays Note -->
      <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 space-y-3">
        <h3 class="font-heading font-bold text-base text-emerald-900 flex items-center gap-2">
          📅 Malaysian Public Holidays & School Breaks
        </h3>
        <p class="text-xs text-emerald-800 leading-relaxed">
          {schoolConfig.identity.shortName} observes all national public holidays as declared by the Malaysian Government, plus additional holidays as gazetted by the Johor State Government. Special breaks are also observed for major Islamic celebrations including Hari Raya Aidilfitri, Hari Raya Aidiladha, and Maulidur Rasul.
        </p>
        <p class="text-xs text-emerald-700 font-semibold">
          For the full 2026 school holiday calendar, please contact the school office or check the official KPM (Kementerian Pendidikan Malaysia) calendar.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
