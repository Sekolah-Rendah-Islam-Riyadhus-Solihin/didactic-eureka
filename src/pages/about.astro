---
import BaseLayout from "../layouts/BaseLayout.astro";
import { schoolConfig } from "../config/school.config";
import { getLocalizedPath } from "../i18n/utils";

const lang = "ms";

const values = [
  {
    icon: "🕌",
    title: "Aqidah & Taqwa",
    desc: "Menanamkan keimanan teguh, mencintai Allah SWT dan Rasulullah SAW serta mengamalkan sunnah dalam kehidupan harian.",
  },
  {
    icon: "🔍",
    title: "Cintakan Ilmu & Hikmah",
    desc: "Menggalakkan sifat ingin tahu, pemikiran kritis dan tradisi keilmuan Islam sepanjang hayat.",
  },
  {
    icon: "🌱",
    title: "Ketabahan & Sabar",
    desc: "Mendidik murid menghadapi cabaran dengan sabar, istiqamah dan berjiwa kental berpaksikan ajaran Islam.",
  },
  {
    icon: "⭐",
    title: "Integriti & Akhlak Mulia",
    desc: "Menghormati guru, ibu bapa, rakan sebaya serta menjadi anggota masyarakat yang berbakti.",
  },
];

const staffMembers = [
  {
    name: schoolConfig.identity.headteacher.name,
    role: schoolConfig.identity.headteacher.title,
    exp: "20+ Tahun Pengalaman Pendidikan Islam",
  },
  {
    name: "Ustaz Ahmad bin Zainudin",
    role: "Penolong Kanan & Ketua Program Tahfiz",
    exp: "15 Tahun Pengkhususan Al-Quran",
  },
  {
    name: "Puan Siti Rahimah binti Ismail",
    role: "Penyelaras Prasekolah & Awal Kanak-kanak",
    exp: "12 Tahun Pendidikan Awal",
  },
  {
    name: "Cikgu Faridah binti Hassan",
    role: "Guru Bimbingan & Kaunseling",
    exp: "10 Tahun Pembangunan Sahsiah",
  },
];

const facilities = [
  {
    name: "Perpustakaan Islam & Sudut Membaca",
    desc: "Lebih 4,000 judul buku ilmiah Islamiah, kisah para nabi, bahan bacaan umum dan sudut multimedia.",
  },
  {
    name: "Dewan Tahfiz & Musolla Sekolah",
    desc: "Ruang solat berjemaah berhawa dingin serta dewan tasmik hafazan Al-Quran yang selesa dan tenang.",
  },
  {
    name: "Makmal Sains & Sudut STEM",
    desc: "Kelengkapan amali sains KSSR, kit robotik junior dan tablet pembelajaran interaktif.",
  },
  {
    name: "Gelanggang Sukan Berbumbung & Laman Herba",
    desc: "Gelanggang serbaguna bagi futsal dan badminton serta taman herba untuk pembelajaran alam sekitar.",
  },
];
---

<BaseLayout lang={lang} title="Tentang Sekolah Kami">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400"
        >Falsafah & Komuniti Kami</span
      >
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">
        Tentang {schoolConfig.identity.name}
      </h1>
      <p
        class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light"
      >
        Sekolah rendah Islam integrasi yang komited membina sahsiah, jati diri
        huffaz dan kecemerlangan akademik sejak {
          schoolConfig.identity.establishedYear
        }.
      </p>
    </div>
  </section>

  <!-- Mission & Headteacher Message -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <span
            class="text-xs font-bold uppercase tracking-wider text-school-primary"
            >Kata Alu-aluan Guru Besar</span
          >
          <h2
            class="text-2xl sm:text-3xl font-heading font-bold text-slate-900"
          >
            "Membimbing akal dan rohani anak-anak ke arah kejayaan dunia dan
            akhirat."
          </h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Selamat datang ke {schoolConfig.identity.name}. Di bilik darjah
            kami, anda akan menyaksikan anak-anak menghafal Al-Quran dengan
            gembira, berdialog ilmiah, membina projek sains dan memupuk ukhuwah
            berlandaskan syariat Islam.
          </p>
          <p class="text-slate-600 text-sm leading-relaxed">
            Sama ada anak anda baru melangkah ke alam prasekolah mahupun bersiap
            sedia untuk peralihan ke sekolah menengah, barisan pendidik kami
            sentiasa memastikan setiap anak dihargai, dibimbing dan dicabar
            potensinya.
          </p>
          <div class="pt-2 border-l-2 border-school-primary pl-4">
            <p class="font-heading font-bold text-slate-900">
              {schoolConfig.identity.headteacher.name}
            </p>
            <p class="text-xs text-slate-500">
              {schoolConfig.identity.headteacher.title}
            </p>
          </div>
        </div>

        <div
          class="bg-slate-100 rounded-3xl p-8 border border-slate-200 space-y-6"
        >
          <h3 class="font-heading font-bold text-xl text-slate-900">
            Misi & Visi Sekolah
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed italic">
            "{schoolConfig.identity.tagline}"
          </p>
          <div class="space-y-3 pt-2 text-xs text-slate-600">
            <p>
              <strong>Pentauliahan:</strong>
              {schoolConfig.identity.affiliation}
            </p>
            <p>
              <strong>Kurikulum:</strong> Integrasi KSSR Kementerian Pendidikan Malaysia
              & Kurikulum Agama/Tahfiz
            </p>
            <p>
              <strong>Komuniti:</strong> Lebih 520 murid, PIBG yang aktif serta barisan
              asatizah dan guru bertauliah.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span
          class="text-xs font-bold uppercase tracking-widest text-school-primary"
          >Paksi Utama</span
        >
        <h2 class="text-3xl font-heading font-bold text-slate-900">
          Nilai Murni Hayatan Warga Sekolah
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          values.map((v) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
              <div class="text-3xl">{v.icon}</div>
              <h3 class="font-heading font-bold text-base text-slate-900">
                {v.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">{v.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Facilities Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span
          class="text-xs font-bold uppercase tracking-widest text-school-primary"
          >Persekitaran Kampus</span
        >
        <h2 class="text-3xl font-heading font-bold text-slate-900">
          Prasarana & Kemudahan Pembelajaran
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          facilities.map((fac) => (
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-school-primary/40 transition space-y-2">
              <h3 class="font-heading font-bold text-base text-slate-900 flex items-center gap-2">
                <span class="text-school-primary">🏫</span> {fac.name}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">{fac.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Teaching Staff -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span
          class="text-xs font-bold uppercase tracking-widest text-school-primary"
          >Barisan Pendidik Kami</span
        >
        <h2 class="text-3xl font-heading font-bold text-slate-900">
          Pengurusan & Guru Utama
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          staffMembers.map((s) => (
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-2 text-center">
              <div class="w-14 h-14 mx-auto rounded-full bg-gradient-to-tr from-school-primary to-emerald-500 flex items-center justify-center text-white text-2xl shadow">
                👨‍🏫
              </div>
              <h3 class="font-heading font-bold text-sm text-slate-900">
                {s.name}
              </h3>
              <p class="text-xs text-school-primary font-semibold">{s.role}</p>
              <p class="text-[11px] text-slate-500">{s.exp}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Safeguarding & Safety Commitment -->
  <section id="safeguarding" class="py-12 bg-emerald-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <div
            class="inline-flex items-center gap-2 text-xs font-bold text-emerald-400 uppercase tracking-widest"
          >
            <span>🛡️</span> Polisi Keselamatan & Kebajikan Murid
          </div>
          <h3 class="text-xl sm:text-2xl font-heading font-bold">
            Keutamaan tertinggi kami adalah keselamatan dan kesejahteraan setiap
            murid.
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl">
            Semua guru dan kakitangan sokongan melalui saringan ketat dan
            menjalani latihan pertolongan cemas serta protokol keselamatan murid
            secara berkala.
          </p>
        </div>
        <a
          href={getLocalizedPath("/contact", lang)}
          class="whitespace-nowrap px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition shadow"
        >
          Hubungi Pasukan Kebajikan →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
