---
import BaseLayout from "../layouts/BaseLayout.astro";
import { schoolConfig } from "../config/school.config";
import SocialLinks from "../components/common/SocialLinks.astro";

const lang = "ms";
---

<BaseLayout lang={lang} title="Hubungi & Lokasi Kampus">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-400"
        >Khidmat Pentadbiran Sekolah</span
      >
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">
        Hubungi {schoolConfig.identity.shortName}
      </h1>
      <p
        class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light"
      >
        Ada sebarang soalan mengenai pendaftaran, jadual harian atau ingin
        mengadakan lawatan ke sekolah? Pihak pejabat kami sedia membantu.
      </p>
    </div>
  </section>

  <!-- Contact Cards & Campus Map info -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div
          class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3"
        >
          <div class="text-3xl">📍</div>
          <h3 class="font-heading font-bold text-base text-slate-900">
            Alamat Sekolah
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            {schoolConfig.contact.address.street}<br />
            {schoolConfig.contact.address.city}, {
              schoolConfig.contact.address.stateZip
            }<br />
            {schoolConfig.contact.address.country}
          </p>
          <a
            href={`https://maps.google.com/?q=${encodeURIComponent(schoolConfig.contact.address.street + ", " + schoolConfig.contact.address.city)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-xs font-semibold text-school-primary hover:underline mt-1"
          >
            Buka di Google Maps →
          </a>
        </div>

        <div
          class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3"
        >
          <div class="text-3xl">📞</div>
          <h3 class="font-heading font-bold text-base text-slate-900">
            Telefon & Kecemasan
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>Talian Utama:</strong>
            {schoolConfig.contact.phone}<br />
            <strong class="text-rose-600">Hotline Kecemasan:</strong>
            {schoolConfig.contact.emergencyPhone}
          </p>
          <p
            class="text-[11px] text-slate-500 pt-1 border-t border-slate-200/60"
          >
            Talian kecemasan beroperasi 24/7 bagi hal kebajikan & keselamatan
            murid.
          </p>
        </div>

        <div
          class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3"
        >
          <div class="text-3xl">⏰</div>
          <h3 class="font-heading font-bold text-base text-slate-900">
            Waktu Operasi Pejabat
          </h3>
          {
            typeof schoolConfig.contact.officeHours === "string" ? (
              <p class="text-xs text-slate-600 leading-relaxed">
                {schoolConfig.contact.officeHours}
              </p>
            ) : (
              <div class="space-y-2.5 text-xs text-slate-600">
                {schoolConfig.contact.officeHours.map((schedule) => {
                  const breakInfo = schedule.breakTime || schedule.breakHours;
                  return (
                    <div class="border-b border-slate-200/70 pb-2 last:border-b-0 last:pb-0">
                      <div class="flex justify-between items-baseline gap-2">
                        <span class="font-semibold text-slate-800">
                          {schedule.days}
                        </span>
                        <span
                          class={
                            schedule.isClosed
                              ? "font-semibold text-rose-600"
                              : "font-semibold text-emerald-700"
                          }
                        >
                          {schedule.isClosed
                            ? "Tutup"
                            : schedule.hours ||
                              `${schedule.openTime} – ${schedule.closeTime}`}
                        </span>
                      </div>
                      {breakInfo && (
                        <div class="text-[11px] text-amber-800 bg-amber-50 border border-amber-200/60 rounded px-1.5 py-0.5 mt-1 flex items-center gap-1">
                          <span>☕</span>
                          <span>
                            {typeof breakInfo === "string"
                              ? `Rehat: ${breakInfo}`
                              : `${breakInfo.label ? `${breakInfo.label}: ` : "Rehat: "}${breakInfo.time}`}
                          </span>
                        </div>
                      )}
                      {schedule.notes && (
                        <div class="text-[10px] text-slate-500 italic mt-0.5">
                          {schedule.notes}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )
          }
        </div>

        <div
          class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3"
        >
          <div class="text-3xl">✉️</div>
          <h3 class="font-heading font-bold text-base text-slate-900">
            Emel & Pertanyaan
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>Pejabat Sekolah:</strong>
            {schoolConfig.contact.email}<br />
            <strong>Pendaftaran:</strong> admissions@{
              schoolConfig.contact.email.split("@")[1]
            }<br />
            Maklum balas akan diberikan dalam tempoh 24 jam hari bekerja.
          </p>
          <div class="pt-2">
            <SocialLinks variant="pills" />
          </div>
        </div>
      </div>

      <!-- Drop-off & Pick-up Gate Guidelines (Anchor: #transport) -->
      <div
        id="transport"
        class="bg-slate-50 border border-slate-200 rounded-3xl p-8 space-y-6"
      >
        <div class="space-y-2">
          <span
            class="text-xs font-bold uppercase tracking-wider text-school-primary"
            >Keselamatan Murid & Aliran Trafik</span
          >
          <h2 class="text-2xl font-heading font-bold text-slate-900">
            🚌 Panduan Pintu Pagar & Zon Van Sekolah
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Demi keselamatan murid sewaktu waktu datang (7:15 – 7:45 Pagi) dan
            waktu pulang (1:00 – 1:30 Petang / 4:00 Petang hari kokurikulum),
            sila patuhi penetapan pintu pagar mengikut tahun:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
          <div
            class="p-4 bg-white rounded-xl border border-slate-200 space-y-2"
          >
            <div class="text-xs font-bold text-emerald-700 uppercase">
              Pintu A (Pintu Utama)
            </div>
            <h4 class="font-bold text-sm text-slate-900">
              Prasekolah & Tahun 1
            </h4>
            <p class="text-xs text-slate-500">
              Ibu bapa/penjaga wajib menghantar murid terus ke guru bertugas.
            </p>
          </div>

          <div
            class="p-4 bg-white rounded-xl border border-slate-200 space-y-2"
          >
            <div class="text-xs font-bold text-sky-700 uppercase">
              Pintu B (Pintu Sampingan)
            </div>
            <h4 class="font-bold text-sm text-slate-900">
              Tahap 1 (Tahun 2 & 3)
            </h4>
            <p class="text-xs text-slate-500">
              Laluan 'Drop-Off' pantas dipantau guru bertugas. Dilarang memarkir
              kenderaan.
            </p>
          </div>

          <div
            class="p-4 bg-white rounded-xl border border-slate-200 space-y-2"
          >
            <div class="text-xs font-bold text-amber-700 uppercase">
              Pintu C (Zon Van Sekolah)
            </div>
            <h4 class="font-bold text-sm text-slate-900">
              Tahap 2 & Zon Bas/Van Sekolah
            </h4>
            <p class="text-xs text-slate-500">
              Kawasan khas garisan kuning untuk van sekolah berdaftar sahaja.
            </p>
          </div>
        </div>
      </div>

      <!-- Social Media & Location -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-slate-900 text-white rounded-2xl p-6 space-y-4">
          <h3 class="font-heading font-bold text-base">
            Ikuti Media Sosial Rasmi
          </h3>
          <p class="text-xs text-slate-400">
            Ketahui aktiviti harian, foto program dan pencapaian anak-anak murid
            SRIRS.
          </p>
          <div class="pt-2">
            <SocialLinks variant="cards" />
          </div>
        </div>

        <div
          class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 space-y-4"
        >
          <h3 class="font-heading font-bold text-base text-emerald-900">
            📍 Panduan Perjalanan
          </h3>
          <div class="text-xs text-emerald-800 space-y-1.5">
            <p>
              🚗 <strong>Kenderaan Sendiri:</strong> Masuk melalui Jalan Kg Sg Kajang.
              Tempat letak kenderaan percuma disediakan.
            </p>
            <p>
              🚌 <strong>Pengangkutan Awam:</strong> Bas henti-henti dari pusat bandar
              Batu Pahat — turun di perhentian Kg Sg Kajang.
            </p>
            <p>
              🚐 <strong>Perkhidmatan Van Sekolah:</strong> Perkhidmatan van berdaftar
              disediakan. Hubungi pejabat untuk zon laluan & kadar tambang.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
