---
import BaseLayout from '../layouts/BaseLayout.astro';
import { schoolConfig } from '../config/school.config';
---

<BaseLayout title="Contact & Campus Location">
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">We Are Here To Help</span>
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">Contact {schoolConfig.identity.shortName}</h1>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light">
        Have questions about enrollment, daily schedules, or visiting our campus? Reach out to our school office.
      </p>
    </div>
  </section>

  <!-- Contact Cards & Campus Map info -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="text-3xl">📍</div>
          <h3 class="font-heading font-bold text-base text-slate-900">Campus Address</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            {schoolConfig.contact.address.street}<br />
            {schoolConfig.contact.address.city}, {schoolConfig.contact.address.stateZip}<br />
            {schoolConfig.contact.address.country}
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="text-3xl">📞</div>
          <h3 class="font-heading font-bold text-base text-slate-900">Phone & Emergency</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>Main Line:</strong> {schoolConfig.contact.phone}<br />
            <strong class="text-rose-600">Urgent Emergency:</strong> {schoolConfig.contact.emergencyPhone}<br />
            <strong>Office Hours:</strong> {schoolConfig.contact.officeHours}
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="text-3xl">✉️</div>
          <h3 class="font-heading font-bold text-base text-slate-900">Email & Inquiries</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>School Office:</strong> {schoolConfig.contact.email}<br />
            <strong>Admissions:</strong> admissions@{schoolConfig.contact.email.split('@')[1]}<br />
            Responses are provided within 24 hours on school days.
          </p>
        </div>

      </div>

      <!-- Drop-off & Pick-up Gate Guidelines (Anchor: #transport) -->
      <div id="transport" class="bg-slate-50 border border-slate-200 rounded-3xl p-8 space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-school-primary">Safety & Traffic Flow</span>
          <h2 class="text-2xl font-heading font-bold text-slate-900">🚌 School Bus & Drop-Off Zones</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            To ensure child safety during morning drop-off (8:15 – 8:40 AM) and afternoon dismissal (3:00 – 3:25 PM), please adhere strictly to designated gates:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
          <div class="p-4 bg-white rounded-xl border border-slate-200 space-y-2">
            <div class="text-xs font-bold text-emerald-700 uppercase">Gate A (Main Entrance)</div>
            <h4 class="font-bold text-sm text-slate-900">Early Years & Kindergarten</h4>
            <p class="text-xs text-slate-500">Hand-in-hand escort required by parent or guardian.</p>
          </div>

          <div class="p-4 bg-white rounded-xl border border-slate-200 space-y-2">
            <div class="text-xs font-bold text-sky-700 uppercase">Gate B (East Oval)</div>
            <h4 class="font-bold text-sm text-slate-900">Lower Primary (Grades 1 – 3)</h4>
            <p class="text-xs text-slate-500">Supervised pedestrian crossing with crossing guards.</p>
          </div>

          <div class="p-4 bg-white rounded-xl border border-slate-200 space-y-2">
            <div class="text-xs font-bold text-amber-700 uppercase">Gate C (Sports Hall)</div>
            <h4 class="font-bold text-sm text-slate-900">Upper Primary & School Bus Bay</h4>
            <p class="text-xs text-slate-500">Designated yellow-line bus drop-off zone only. No private cars.</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
