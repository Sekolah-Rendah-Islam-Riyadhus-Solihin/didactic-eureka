---
import BaseLayout from '../layouts/BaseLayout.astro';
import { schoolConfig } from '../config/school.config';

const isPrivate = schoolConfig.identity.schoolType === 'private';

const steps = isPrivate
  ? [
      { step: "01", title: "Submit Online Inquiry", desc: "Fill out the preliminary student inquiry form below or attend one of our open mornings." },
      { step: "02", title: "Campus Tour & Informal Chat", desc: "Meet our headteacher, explore our classrooms, and let your child experience our play areas." },
      { step: "03", title: "Offer of Place & Deposit", desc: "Following assessment of class capacity, a formal offer letter will be sent with payment details." },
      { step: "04", title: "Welcome & Induction", desc: "Receive your welcome pack, order school uniform, and attend the new families orientation morning." },
    ]
  : [
      { step: "01", title: "Verify Your Catchment Zone", desc: `Confirm your residential address falls within ${schoolConfig.identity.shortName}'s designated school zone.` },
      { step: "02", title: "Submit Enrollment Application", desc: "Complete the official public school enrollment form with proof of address and birth certificate." },
      { step: "03", title: "Enrollment Confirmation", desc: "The school office reviews documents and registers your child under the state education registry." },
      { step: "04", title: "Kindergarten / Grade Transition", desc: "Attend our step-up transition morning to meet class teachers and receive your free stationery starter pack." },
    ];

const privateFees = [
  { stage: "Kindergarten & Early Years", termFee: "$1,850", annualFee: "$5,550", notes: "Includes hot lunch & snack" },
  { stage: "Lower Primary (Grades 1 – 3)", termFee: "$2,200", annualFee: "$6,600", notes: "Includes all text and exercise books" },
  { stage: "Upper Primary (Grades 4 – 6)", termFee: "$2,450", annualFee: "$7,350", notes: "Includes STEM lab materials & swimming" },
];
---

<BaseLayout title={isPrivate ? "Admissions & Tuition Fees" : "Enrollment & Catchment Zone"}>
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest {isPrivate ? 'text-amber-400' : 'text-emerald-400'}">
        {isPrivate ? 'Private School Admissions' : 'Community School Enrollment'}
      </span>
      <h1 class="text-3xl sm:text-5xl font-heading font-bold">
        {isPrivate ? 'Admissions & Tuition Fees' : 'How to Enroll Your Child'}
      </h1>
      <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-300 font-light">
        We are thrilled to welcome new families into the {schoolConfig.identity.shortName} community for the upcoming academic year.
      </p>
    </div>
  </section>

  <!-- Step-by-Step Admissions Process -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-school-primary">Clear & Simple</span>
        <h2 class="text-3xl font-heading font-bold text-slate-900">4-Step Enrollment Process</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((s) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 relative space-y-3">
            <span class="text-4xl font-extrabold font-heading text-school-primary/20">
              {s.step}
            </span>
            <h3 class="font-heading font-bold text-base text-slate-900">{s.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Conditional Section: Fees (Private) vs Catchment & Subsidies (Government) -->
  {isPrivate ? (
    <!-- PRIVATE SCHOOL: Tuition Schedule -->
    <section class="py-16 bg-slate-50 border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Transparent Pricing</span>
          <h2 class="text-3xl font-heading font-bold text-slate-900">Tuition Fees Schedule (2026/27)</h2>
          <p class="text-sm text-slate-600">All fees include standard tuition, learning resources, and sports equipment.</p>
        </div>

        <div class="overflow-x-auto max-w-4xl mx-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm">
            <thead>
              <tr class="bg-slate-900 text-white">
                <th class="p-4 font-heading font-bold">Grade Level</th>
                <th class="p-4 font-heading font-bold">Per Term (3 Terms)</th>
                <th class="p-4 font-heading font-bold">Annual Full Payment</th>
                <th class="p-4 font-heading font-bold">Inclusions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {privateFees.map((f) => (
                <tr class="hover:bg-slate-50">
                  <td class="p-4 font-bold text-slate-900">{f.stage}</td>
                  <td class="p-4 font-semibold text-school-primary">{f.termFee}</td>
                  <td class="p-4 font-semibold text-slate-900">{f.annualFee}</td>
                  <td class="p-4 text-slate-600">{f.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="max-w-4xl mx-auto p-4 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 flex items-start gap-3">
          <span class="text-lg">⭐</span>
          <div>
            <p class="font-bold">Sibling Discount & Means-Tested Bursaries:</p>
            <p>A 10% discount is applied automatically for second and subsequent siblings. Bursary applications open every October.</p>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <!-- GOVERNMENT SCHOOL: Catchment & Free Assistance -->
    <section class="py-16 bg-slate-50 border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-700">Public Education</span>
          <h2 class="text-3xl font-heading font-bold text-slate-900">Catchment Area & Government Support</h2>
          <p class="text-sm text-slate-600">Tuition is 100% free and funded by the Department of Education.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h3 class="font-heading font-bold text-lg text-slate-900 flex items-center gap-2">
              <span>📍</span> Catchment Area Guidelines
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Children living permanently within our designated community boundary are guaranteed enrollment. Please bring the following documents to the school office:
            </p>
            <ul class="text-xs text-slate-600 space-y-2">
              <li class="flex items-center gap-2">✓ Proof of residency (utility bill or council tax statement)</li>
              <li class="flex items-center gap-2">✓ Child's official birth certificate or passport</li>
              <li class="flex items-center gap-2">✓ Child's up-to-date immunization / health card</li>
              <li class="flex items-center gap-2">✓ Previous school transfer certificate (for Grades 1–6)</li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h3 class="font-heading font-bold text-lg text-slate-900 flex items-center gap-2">
              <span>🍎</span> Free Government Schemes & Assistance
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              We ensure every student has equal access to all school activities without economic barriers:
            </p>
            <ul class="text-xs text-slate-600 space-y-2">
              <li class="flex items-center gap-2">✓ <strong>Universal Free School Breakfast:</strong> Available daily from 7:45 AM</li>
              <li class="flex items-center gap-2">✓ <strong>Textbook & Device Subsidy:</strong> Tablets & stationery provided free</li>
              <li class="flex items-center gap-2">✓ <strong>School Uniform Grant Scheme:</strong> Support for qualifying families</li>
              <li class="flex items-center gap-2">✓ <strong>Free Walking Bus:</strong> Supervised adult walking groups from town center</li>
            </ul>
          </div>

        </div>
      </div>
    </section>
  )}

  <!-- Parent Inquiry / Application Form -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-school-primary">Get In Touch</span>
        <h2 class="text-3xl font-heading font-bold text-slate-900">
          {isPrivate ? 'Student Application & Tour Request' : 'Enrollment Inquiry & Tour Booking'}
        </h2>
        <p class="text-sm text-slate-600">
          Fill out the form below. Our admissions registrar will reach out to schedule an informal school visit.
        </p>
      </div>

      <form id="inquiry-form" class="bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="childName">Child's Full Name *</label>
            <input type="text" id="childName" name="childName" required class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-school-primary focus:border-transparent" placeholder="e.g. Oliver Vance" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="grade">Grade Applying For *</label>
            <select id="grade" name="grade" required class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-school-primary focus:border-transparent bg-white">
              <option value="kindergarten">Kindergarten / Reception (Ages 4-5)</option>
              <option value="grade1">Grade 1 (Ages 5-6)</option>
              <option value="grade2">Grade 2 (Ages 6-7)</option>
              <option value="grade3">Grade 3 (Ages 7-8)</option>
              <option value="grade4">Grade 4 (Ages 8-9)</option>
              <option value="grade5">Grade 5 (Ages 9-10)</option>
              <option value="grade6">Grade 6 (Ages 10-11)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="parentName">Parent / Guardian Name *</label>
            <input type="text" id="parentName" name="parentName" required class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-school-primary focus:border-transparent" placeholder="e.g. Sarah Vance" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="phone">Phone Number *</label>
            <input type="tel" id="phone" name="phone" required class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-school-primary focus:border-transparent" placeholder="+1 (555) 000-0000" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="email">Parent Email Address *</label>
          <input type="email" id="email" name="email" required class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-school-primary focus:border-transparent" placeholder="parent@example.com" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1" for="message">Questions or Specific Notes</label>
          <textarea id="message" name="message" rows="3" class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-school-primary focus:border-transparent" placeholder="Mention preferred start term, learning needs, or scheduling questions..."></textarea>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl bg-school-primary text-white font-bold text-xs uppercase tracking-wider hover:bg-school-primary-hover transition-colors shadow-md flex items-center justify-center gap-2"
          >
            <span>Submit Admissions Inquiry</span>
            <span>→</span>
          </button>
        </div>

        <p id="form-feedback" class="hidden text-center text-xs font-bold text-emerald-700 pt-2">
          ✓ Thank you! Your inquiry has been registered. Our admissions office will reach out within 1 business day.
        </p>

        <!-- Cloudflare Pages Functions / Laravel Note -->
        <p class="text-[11px] text-slate-400 text-center pt-2">
          Protected by Cloudflare Turnstile • Directly connectable to Laravel REST API (<code class="bg-slate-200 px-1 py-0.5 rounded text-slate-700">POST /api/admissions</code>)
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('inquiry-form');
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Simulate successful submission or dispatch to Cloudflare Pages Functions / Laravel API
    if (feedback) {
      feedback.classList.remove('hidden');
      form.reset();
    }
  });
</script>
