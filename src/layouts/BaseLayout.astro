---
import '../styles/global.css';
import { schoolConfig } from '../config/school.config';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import EmergencyBanner from '../components/layout/EmergencyBanner.astro';
import MaintenanceScreen from '../components/system/MaintenanceScreen.astro';
import MaintenanceBypassBanner from '../components/system/MaintenanceBypassBanner.astro';
import DevModeDock from '../components/system/DevModeDock.astro';
import AccessibilityModal from '../components/common/AccessibilityModal.astro';
import MobileQuickBar from '../components/layout/MobileQuickBar.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  showEmergencyNotice?: boolean;
  noticeText?: string;
  lang?: SupportedLanguage;
}

const {
  title,
  description = schoolConfig.identity.tagline,
  showEmergencyNotice = true,
  noticeText,
  lang,
} = Astro.props;

const currentLang: SupportedLanguage = lang || getLangFromUrl(Astro.url);

const pageTitle = title
  ? `${title} | ${schoolConfig.identity.name}`
  : `${schoolConfig.identity.name} — ${schoolConfig.identity.tagline}`;

const schemaOrgData = {
  "@context": "https://schema.org",
  "@type": "School",
  "name": schoolConfig.identity.name,
  "description": schoolConfig.identity.tagline,
  "inLanguage": currentLang,
  "telephone": schoolConfig.contact.phone,
  "email": schoolConfig.contact.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": schoolConfig.contact.address.street,
    "addressLocality": schoolConfig.contact.address.city,
    "postalCode": schoolConfig.contact.address.stateZip,
    "addressCountry": schoolConfig.contact.address.country,
  },
};

const alternateMs = getLocalizedPath(Astro.url.pathname, 'ms');
const alternateEn = getLocalizedPath(Astro.url.pathname, 'en');

const isMaintenanceActive = schoolConfig.system?.maintenance?.enabled || false;
const bypassKey = schoolConfig.system?.maintenance?.bypassKey || "srirs-dev-2026";
const isLoggingEnabled = schoolConfig.system?.logging?.enabled || false;
const logLevel = schoolConfig.system?.logging?.level || "info";
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <!-- Hreflang SEO Alternate Links -->
    <link rel="alternate" hreflang="ms" href={alternateMs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateMs} />

    <!-- Schema.org JSON-LD for School SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />

    <!-- Dynamic Theme Injection from school.config.ts -->
    <style define:vars={{
      primary: schoolConfig.branding.primary,
      primaryHover: schoolConfig.branding.primaryHover,
      primaryLight: schoolConfig.branding.primaryLight,
      secondary: schoolConfig.branding.secondary,
      secondaryHover: schoolConfig.branding.secondaryHover,
      accent: schoolConfig.branding.accent,
      surface: schoolConfig.branding.surface,
      dark: schoolConfig.branding.dark,
      muted: schoolConfig.branding.muted,
    }}>
      :root {
        --color-school-primary: var(--primary);
        --color-school-primary-hover: var(--primaryHover);
        --color-school-primary-light: var(--primaryLight);
        --color-school-secondary: var(--secondary);
        --color-school-secondary-hover: var(--secondaryHover);
        --color-school-accent: var(--accent);
        --color-school-surface: var(--surface);
        --color-school-dark: var(--dark);
        --color-school-muted: var(--muted);
      }
    </style>
    <!-- Immediate A11y Theme Initializer (Prevents FOUC on page load) -->
    <script is:inline>
      (function () {
        try {
          const raw = localStorage.getItem("srirs_a11y_prefs");
          if (raw) {
            const prefs = JSON.parse(raw);
            const root = document.documentElement;
            if (prefs.fontSize && prefs.fontSize !== "normal") root.setAttribute("data-font-size", prefs.fontSize);
            if (prefs.highContrast) root.setAttribute("data-contrast", "high");
            if (prefs.readableFont) root.setAttribute("data-readable-font", "true");
            if (prefs.reducedMotion) root.setAttribute("data-reduced-motion", "true");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-slate-50 antialiased selection:bg-school-primary-light selection:text-school-primary">
    {isMaintenanceActive ? (
      <>
        <!-- Maintenance Mode Screen (Default for public visitors) -->
        <div id="maintenance-view" class="w-full">
          <MaintenanceScreen lang={currentLang} />
        </div>

        <!-- Bypass Protected Site (Shown only when bypass key is authenticated) -->
        <div id="bypass-site-view" class="hidden min-h-screen flex-col w-full">
          <MaintenanceBypassBanner lang={currentLang} />
          {showEmergencyNotice && <EmergencyBanner notice={noticeText} lang={currentLang} />}
          <Header lang={currentLang} />
          <main id="main-content" class="flex-grow pb-16 sm:pb-0">
            <slot />
          </main>
          <Footer lang={currentLang} />
        </div>

        <!-- Client-side Maintenance Bypass Logic -->
        <script define:vars={{ bypassKey }}>
          function evaluateMaintenanceBypass() {
            const params = new URLSearchParams(window.location.search);
            const urlBypass = params.get('bypass');
            const sessionBypass = sessionStorage.getItem('maintenance_bypass');

            // Handle explicit bypass logout
            if (urlBypass === 'off' || urlBypass === 'false') {
              sessionStorage.removeItem('maintenance_bypass');
              return;
            }

            const isAuthorized = (urlBypass && urlBypass === bypassKey) || sessionBypass === 'true';

            if (isAuthorized) {
              sessionStorage.setItem('maintenance_bypass', 'true');
              const maintView = document.getElementById('maintenance-view');
              const bypassView = document.getElementById('bypass-site-view');
              if (maintView && bypassView) {
                maintView.classList.add('hidden');
                bypassView.classList.remove('hidden');
                bypassView.classList.add('flex');
              }
            }
          }

          evaluateMaintenanceBypass();
          document.addEventListener('astro:after-swap', evaluateMaintenanceBypass);
        </script>
      </>
    ) : (
      <>
        {showEmergencyNotice && <EmergencyBanner notice={noticeText} lang={currentLang} />}
        <Header lang={currentLang} />
        <main id="main-content" class="flex-grow pb-16 sm:pb-0">
          <slot />
        </main>
        <Footer lang={currentLang} />
      </>
    )}

    <!-- Accessibility Control Modal -->
    <AccessibilityModal lang={currentLang} />

    <!-- Mobile Sticky Quick Bar (Phone screen actions) -->
    <MobileQuickBar lang={currentLang} />

    <!-- Floating Dev Mode Dock (Controlled by school.config.ts) -->
    <DevModeDock lang={currentLang} />

    <!-- Diagnostics Logging Script -->
    {isLoggingEnabled && (
      <script define:vars={{ path: Astro.url.pathname, lang: currentLang, logLevel }}>
        console.info(
          `%c[SRIRS System]%c Route loaded: %c${path}%c [${lang.toUpperCase()}]`,
          "background: #0f172a; color: #10b981; font-weight: bold; padding: 2px 6px; border-radius: 4px;",
          "color: #94a3b8; font-size: 11px;",
          "color: #38bdf8; font-weight: bold; font-family: monospace;",
          "color: #a855f7; font-weight: bold;"
        );
      </script>
    )}
  </body>
</html>
